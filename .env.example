# Required for Supabase production / preview deployments (server-side only, never NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional cloud & runtime configuration (leave blank or unset unless needed)
# STORE_BACKEND automatically selects "supabase" when any SUPABASE_* variable is set.
# Set STORE_BACKEND=local only to force the local JSON file store.
# STORE_BACKEND=supabase
# Recommended in production (32+ random characters for signing checkout tokens)
# SESSION_SECRET=
# CATALOG_CACHE_SECONDS=30
PUBLIC_DEMO_MODE=false
# ADMIN_SETUP_TOKEN=